@@ -136,11 +136,11 @@ private void B_Save_Click(object sender, EventArgs e)
     private void ReadJoyful(ISaveBlock3SmallExpansion j)
     {
         TB_J1.Text = Math.Min((ushort)9999, j.JoyfulJumpInRow).ToString();
-        TB_J2.Text = Math.Min(99990, j.JoyfulJumpScore).ToString();
+        TB_J2.Text = TopesJuego.PuntuacionMinijuego(j, salto: true).ToString(); // Pokekeep 1.1.3: u32 en el juego (TopesJuego)
         TB_J3.Text = Math.Min((ushort)9999, j.JoyfulJump5InRow).ToString();
         TB_J4.Text = Math.Min((ushort)9999, j.JoyfulJumpGamesMaxPlayers).ToString();
         TB_B1.Text = Math.Min((ushort)9999, j.JoyfulBerriesInRow).ToString();
-        TB_B2.Text = Math.Min(99990, j.JoyfulBerriesScore).ToString();
+        TB_B2.Text = TopesJuego.PuntuacionMinijuego(j, salto: false).ToString();
         TB_B3.Text = Math.Min((ushort)9999, j.JoyfulBerries5InRow).ToString();
         TB_BerryPowder.Text = Math.Min(99999u, j.BerryPowder).ToString();
     }
@@ -148,11 +148,11 @@ private void ReadJoyful(ISaveBlock3SmallExpansion j)
     private void SaveJoyful(ISaveBlock3SmallExpansion j)
     {
         j.JoyfulJumpInRow = (ushort)Util.ToUInt32(TB_J1.Text);
-        j.JoyfulJumpScore = (ushort)Util.ToUInt32(TB_J2.Text);
+        TopesJuego.PonerPuntuacionMinijuego(j, salto: true, Util.ToUInt32(TB_J2.Text));
         j.JoyfulJump5InRow = (ushort)Util.ToUInt32(TB_J3.Text);
         j.JoyfulJumpGamesMaxPlayers = (ushort)Util.ToUInt32(TB_J4.Text);
         j.JoyfulBerriesInRow = (ushort)Util.ToUInt32(TB_B1.Text);
-        j.JoyfulBerriesScore = (ushort)Util.ToUInt32(TB_B2.Text);
+        TopesJuego.PonerPuntuacionMinijuego(j, salto: false, Util.ToUInt32(TB_B2.Text));
         j.JoyfulBerries5InRow = (ushort)Util.ToUInt32(TB_B3.Text);
         j.BerryPowder = Util.ToUInt32(TB_BerryPowder.Text);
     }
@@ -580,13 +580,19 @@ private void LoadRecords()
         return;
 
         void ChangeFame() => SAV.SetRecord(1, (uint)(NUD_RecordValue.Value = GetFameTime()));
-        void LoadRecordID(int index) => NUD_RecordValue.Value = SAV.GetRecord(index);
+        // Pokekeep 1.1.3: cada récord se para en 0xFFFFFF en el juego (TopesJuego.RegistroGen3); el 1 es la hora del Salón y se escribe entera.
+        void LoadRecordID(int index)
+        {
+            var actual = SAV.GetRecord(index);
+            NUD_RecordValue.Maximum = index == TopesJuego.RegistroGen3TiempoSalon ? uint.MaxValue : Math.Max(TopesJuego.RegistroGen3, actual);
+            NUD_RecordValue.Value = actual;
+        }
         void LoadFame(uint val) => SetFameTime(val);
     }
 
     public uint GetFameTime()
     {
-        var hrs = Math.Min(9999, (uint)NUD_FameH.Value);
+        var hrs = Math.Min(999, (uint)NUD_FameH.Value);
         var min = Math.Min(59, (uint)NUD_FameM.Value);
         var sec = Math.Min(59, (uint)NUD_FameS.Value);
 
