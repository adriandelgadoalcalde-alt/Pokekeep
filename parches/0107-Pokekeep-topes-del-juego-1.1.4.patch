diff --git a/PKHeX.WinForms/Pokekeep/TopesFormulario.cs b/PKHeX.WinForms/Pokekeep/TopesFormulario.cs
new file mode 100644
index 000000000..291913b44
--- /dev/null
+++ b/PKHeX.WinForms/Pokekeep/TopesFormulario.cs
@@ -0,0 +1,20 @@
+using System;
+using System.Windows.Forms;
+
+namespace PKHeX.WinForms;
+
+/// <summary>
+/// Pokekeep 1.1.4: topes del juego en los formularios de escritorio. Un <see cref="NumericUpDown"/> ya se queda en su <c>Maximum</c> al escribir de más;
+/// una <see cref="MaskedTextBox"/> no (su máscara solo cuenta cifras: 3 cifras dejan 999 aunque el juego pare en 300), así que aquí se recorta el texto
+/// al salir de la caja y, al guardar, con <see cref="Acotar(string, uint)"/>.
+/// </summary>
+internal static class TopesFormulario
+{
+    /// <summary>Al salir de la caja, un número mayor que <paramref name="tope"/> se sustituye por el propio tope.</summary>
+    public static void AcotarAlSalir(MaskedTextBox caja, uint tope)
+        => caja.Leave += (_, _) => caja.Text = Acotar(caja.Text, tope).ToString();
+
+    /// <summary>Número de un texto con máscara (vacío o con huecos = 0) recortado al tope.</summary>
+    public static uint Acotar(string texto, uint tope)
+        => uint.TryParse(texto.Trim(), out var valor) ? Math.Min(valor, tope) : 0;
+}
