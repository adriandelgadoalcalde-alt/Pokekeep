@@ -0,0 +1,96 @@
+using System;
+using System.Drawing;
+using System.Windows.Forms;
+using AutoLegalidad.Ui;
+using AutoLegalidad.Ui.Operation;
+using PKHeX.WinForms.Properties;
+
+namespace PKHeX.WinForms;
+
+/// <summary>
+/// Pokekeep (Hito 4): parte de la ventana principal que añade los dos botones del editor, las entradas del menú Herramientas, la barra de operación
+/// y la pestaña «Librería». La lógica está en AutoLegalidad.Ui; aquí solo se colocan los controles y se conectan los puntos de integración.
+/// </summary>
+public partial class Main
+{
+    private Panel? _pkStrip;
+    private Button? _pkLegalize;
+    private Button? _pkOptimize;
+    private ToolStripMenuItem? _pkMenuLegalize;
+    private ToolStripMenuItem? _pkMenuOptimize;
+    private ToolStripMenuItem? _pkMenuLibrary;
+    private ToolTip? _pkTip;
+    private bool _pkBarGrown;
+
+    private void InitializePokekeep()
+    {
+        var app = Pokekeep.Initialize(this, C_SAV, UpdatePokekeepAvailability);
+        _pkTip = new ToolTip();
+
+        // ---- Botones del editor, junto al estado de legalidad (franja inferior del panel del editor) ----
+        _pkLegalize = new Button { Name = "B_PokekeepLegalizar", Text = Textos.LegalizarAutomaticamente, Image = Resources.wand, ImageAlign = ContentAlignment.MiddleLeft, TextImageRelation = TextImageRelation.ImageBeforeText, AutoSize = true, AutoSizeMode = AutoSizeMode.GrowAndShrink, Margin = new Padding(3, 3, 3, 3), Padding = new Padding(4, 0, 4, 0) };
+        _pkOptimize = new Button { Name = "B_PokekeepOptimizar", Text = Textos.OptimizarStats, Image = Resources.vallohi, ImageAlign = ContentAlignment.MiddleLeft, TextImageRelation = TextImageRelation.ImageBeforeText, AutoSize = true, AutoSizeMode = AutoSizeMode.GrowAndShrink, Margin = new Padding(3, 3, 3, 3), Padding = new Padding(4, 0, 4, 0) };
+        _pkLegalize.Click += (_, _) => Pokekeep.RunOnEditor(PokekeepAction.Legalize);
+        _pkOptimize.Click += (_, _) => Pokekeep.RunOnEditor(PokekeepAction.Optimize);
+        var flow = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.LeftToRight, WrapContents = false, Padding = new Padding(2, 0, 0, 0) };
+        flow.Controls.Add(_pkLegalize);
+        flow.Controls.Add(_pkOptimize);
+        _pkStrip = new Panel { Name = "P_Pokekeep", Dock = DockStyle.Bottom, Height = 34 };
+        _pkStrip.Controls.Add(flow);
+        splitContainer1.Panel1.Controls.Add(_pkStrip);
+        _pkStrip.SendToBack();                  // las franjas ancladas abajo se colocan antes que el editor (Fill)
+        Height += _pkStrip.Height;              // el editor conserva su tamaño de siempre
+
+        // ---- Barra de operación (progreso, Cancelar, resumen, Ver cambios, Deshacer) ----
+        app.Bar.VisibleChanged += (_, _) => AdjustForPokekeepBar(app.Bar);
+        Controls.Add(app.Bar);
+        app.Bar.SendToBack();
+
+        // ---- Menú Herramientas ----
+        Menu_Tools.DropDownItems.Add(new ToolStripSeparator());
+        _pkMenuLegalize = new ToolStripMenuItem(Textos.LegalizarAutomaticamente) { Name = "Menu_PokekeepLegalizar", Image = Resources.wand };
+        _pkMenuOptimize = new ToolStripMenuItem(Textos.OptimizarStats) { Name = "Menu_PokekeepOptimizar", Image = Resources.vallohi };
+        _pkMenuLibrary = new ToolStripMenuItem(Textos.LibreriaMenu) { Name = "Menu_PokekeepLibreria", Image = Resources.database };
+        _pkMenuLegalize.Click += (_, _) => Pokekeep.RunOnEditor(PokekeepAction.Legalize);
+        _pkMenuOptimize.Click += (_, _) => Pokekeep.RunOnEditor(PokekeepAction.Optimize);
+        _pkMenuLibrary.Click += (_, _) => app.OpenLibraryWindow(this);
+        Menu_Tools.DropDownItems.AddRange([_pkMenuLegalize, _pkMenuOptimize, _pkMenuLibrary]);
+
+        // ---- Pestaña «Librería» junto a Caja, Equipo, Otro y SAV ----
+        Pokekeep.AddLibraryTab(C_SAV.AddExtraTab);
+
+        UpdatePokekeepAvailability();
+    }
+
+    /// <summary>Activa o desactiva los botones y las entradas de menú del editor según el estado actual, con el motivo como ayuda.</summary>
+    private void UpdatePokekeepAvailability()
+    {
+        if (_pkLegalize is null || _pkOptimize is null || _pkTip is null)
+            return;
+        var av = Pokekeep.EditorAvailability();
+        var tipLegalize = av.Enabled ? Textos.LegalizarTooltip : av.Reason ?? string.Empty;
+        var tipOptimize = av.Enabled ? Textos.OptimizarTooltip : av.Reason ?? string.Empty;
+        _pkLegalize.Enabled = _pkOptimize.Enabled = av.Enabled;
+        _pkTip.SetToolTip(_pkLegalize, tipLegalize);
+        _pkTip.SetToolTip(_pkOptimize, tipOptimize);
+        if (_pkMenuLegalize is not null) { _pkMenuLegalize.Enabled = av.Enabled; _pkMenuLegalize.ToolTipText = tipLegalize; }
+        if (_pkMenuOptimize is not null) { _pkMenuOptimize.Enabled = av.Enabled; _pkMenuOptimize.ToolTipText = tipOptimize; }
+    }
+
+    /// <summary>La barra ocupa su propia franja: la ventana crece lo que mide para que el resto no se encoja (y vuelve a su tamaño al ocultarla).</summary>
+    private void AdjustForPokekeepBar(Control bar)
+    {
+        if (WindowState != FormWindowState.Normal)
+            return;
+        if (bar.Visible && !_pkBarGrown)
+        {
+            Height += bar.Height;
+            _pkBarGrown = true;
+        }
+        else if (!bar.Visible && _pkBarGrown)
+        {
+            Height -= bar.Height;
+            _pkBarGrown = false;
+        }
+    }
+}
diff --git a/PKHeX.WinForms/Pokekeep/PokekeepIntegration.cs b/PKHeX.WinForms/Pokekeep/PokekeepIntegration.cs
new file mode 100644
index 000000000..3477d82c1
--- /dev/null
+++ b/PKHeX.WinForms/Pokekeep/PokekeepIntegration.cs
@@ -0,0 +1,106 @@
+using System;
+using System.Drawing;
+using System.Windows.Forms;
+using AutoLegalidad.Ui;
+using AutoLegalidad.Ui.Library;
+using AutoLegalidad.Ui.Operation;
+using PKHeX.Core;
+using PKHeX.WinForms.Controls;
+
+namespace PKHeX.WinForms;
+
+/// <summary>
+/// Pokekeep (Hito 4): puntos EXPLÍCITOS de integración de «Legalizar automáticamente», «Optimizar stats» y la Librería en PKHeX.WinForms.
+/// Todo lo demás (coordinador, barra, Librería, ajustes) vive en AutoLegalidad.Ui. Este fichero no usa reflexión sobre controles privados: solo
+/// recibe lo que PKHeX ya expone (<see cref="SAVEditor.EditEnv"/>, <see cref="Main"/>) y se lo da al coordinador.
+/// </summary>
+internal static class Pokekeep
+{
+    public static PokekeepApp? App { get; private set; }
+    private static SAVEditor? _sav;
+    private static Action? _availabilityChanged;
+
+    /// <summary>Se llama una vez, desde el constructor de <see cref="Main"/>, con los controles ya creados.</summary>
+    public static PokekeepApp Initialize(Main main, SAVEditor sav, Action availabilityChanged)
+    {
+        _sav = sav;
+        _availabilityChanged = availabilityChanged;
+        App = new PokekeepApp(new MainHost(main, sav), Program.Settings.Pokekeep);
+        App.Coordinator.ProgressChanged += (_, _) => availabilityChanged();
+        App.Coordinator.Completed += (_, _) => availabilityChanged();
+        return App;
+    }
+
+    /// <summary>Añade la pestaña «Librería» al panel de la derecha (junto a Caja, Equipo, Otro y Guardado).</summary>
+    public static void AddLibraryTab(Action<TabPage> addTab)
+    {
+        if (App is null)
+            return;
+        var page = new TabPage(Textos.LibreriaPestana) { Name = "Tab_Libreria", UseVisualStyleBackColor = true, Padding = new Padding(4) };
+        page.Controls.Add(App.CreateLibraryView());
+        addTab(page);
+    }
+
+    /// <summary>Avisa a la Librería de que se abrió (o cerró) otra partida.</summary>
+    public static void NotifySaveChanged()
+    {
+        if (_sav is null)
+            return;
+        foreach (var view in FindLibraryViews(_sav.FindForm()))
+            view.NotifySaveChanged();
+        _availabilityChanged?.Invoke();
+    }
+
+    private static System.Collections.Generic.IEnumerable<LibraryView> FindLibraryViews(Form? form)
+    {
+        if (form is null)
+            yield break;
+        foreach (var c in form.Controls.Find("LibraryView", true))
+            if (c is LibraryView v)
+                yield return v;
+    }
+
+    // ---- Acciones ----
+    public static void RunOnEditor(PokekeepAction action) => Fire(App?.Coordinator.RunOnEditorAsync(action));
+    public static void RunOnSlot(PokekeepAction action, ISlotInfo slot) => Fire(App?.Coordinator.RunOnSlotAsync(action, slot));
+
+    public static Availability EditorAvailability() => App?.Coordinator.GetEditorAvailability() ?? Availability.No("Pokekeep no está disponible.");
+    public static Availability SlotAvailability(ISlotInfo slot) => App?.Coordinator.GetSlotAvailability(slot) ?? Availability.No("Pokekeep no está disponible.");
+
+    /// <summary>
+    /// Suelta de una entrada de la Librería sobre una casilla (arrastre). Devuelve true si el arrastre era de la Librería y ya se ha gestionado.
+    /// La casilla se fija AQUÍ (la que hay bajo el ratón al soltar); nunca se sobrescribe.
+    /// </summary>
+    public static bool TryDropLibraryEntry(DragEventArgs e, ISlotInfo slot)
+    {
+        if (App is null || e.Data?.GetDataPresent(LibraryView.DragFormat) != true)
+            return false;
+        var row = LibraryView.DraggedRow;
+        if (row is not null)
+            Fire(App.Coordinator.AddLibraryEntryAsync(row, slot));
+        return true;
+    }
+
+    /// <summary>Lanza la tarea sin esperar (el resultado llega por los eventos del coordinador) y no deja escapar excepciones sin registrar.</summary>
+    private static async void Fire(System.Threading.Tasks.Task? task)
+    {
+        if (task is null)
+            return;
+        try
+        {
+            await task.ConfigureAwait(true);
+        }
+        catch (Exception ex) when (ex is not OutOfMemoryException)
+        {
+            WinFormsUtil.Error("Pokekeep: error inesperado. No se ha modificado nada.", ex);
+        }
+    }
+
+    private sealed class MainHost(Main main, SAVEditor sav) : IPokekeepHost
+    {
+        public IWin32Window? Window => main;
+        public SaveDataEditor<PictureBox> Env => sav.EditEnv;
+        public int CurrentBox => sav.CurrentBox;
+        public void NotifyUndoRedoChanged() => sav.UpdateUndoRedo();
+    }
+}
