     public static void AcotarAlSalir(MaskedTextBox caja, uint tope)
         => caja.Leave += (_, _) => caja.Text = Acotar(caja.Text, tope).ToString();
 
+    /// <summary>
+    /// Primera fecha que cabe en el campo de año de <c>Epoch1900DateTimeValue</c> (Pokekeep 1.1.5): el año se guarda en 12 bits contados desde 1900
+    /// (<c>Epoch1900DateTimeValue.cs:18</c>, <c>EpochDateTime.cs:10</c>) y <c>RawYear</c> no enmascara, así que un año anterior se convertía en un negativo que se
+    /// mezclaba con <c>|</c> en los 32 bits de la fecha y borraba mes, día, hora y minuto. El otro extremo cabe: 1900 + 4095 = 5995, y los selectores paran en 4095.
+    /// </summary>
+    public static readonly DateTime FechaMinima1900 = new(1900, 1, 1);
+
+    /// <summary>
+    /// Primera fecha que cabe en el campo de milisegundos del donut de Z-A (Pokekeep 1.1.5): se cuentan desde 1970 (<c>Donut9a.Epoch</c>) en un <c>ulong</c>, y un instante anterior daba un negativo que,
+    /// convertido a <c>ulong</c>, queda en 0: el selector enseñaba 1960 y la partida guardaba 1970 (<c>DonutEditor9a.cs:332, 354, 370</c>). El selector paraba en 1753.
+    /// </summary>
+    public static readonly DateTime FechaMinima1970 = new(1970, 1, 1);
+
     /// <summary>Número de un texto con máscara (vacío o con huecos = 0) recortado al tope.</summary>
     public static uint Acotar(string texto, uint tope)
         => uint.TryParse(texto.Trim(), out var valor) ? Math.Min(valor, tope) : 0;
