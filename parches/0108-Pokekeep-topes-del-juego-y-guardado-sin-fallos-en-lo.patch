 using System;
 using System.Windows.Forms;
+using AutoLegalidad.Desafios;
 using PKHeX.Core;
 
 namespace PKHeX.WinForms;
 
 public sealed partial class PokeathlonEventRecord4Editor : UserControl
 {
+    // Pokekeep 1.1.5: el récord en bruto de cada prueba tiene su tope en el juego (TopesJuego.PokeathlonRecordBruto: 999, 999, 1.023, 4.095 o el del dato).
+    // 0xFFFF no es un récord, es «sin récord» (pokeathlon_save.c:10-14): se puede mostrar y conservar, pero no se alcanza escribiendo un número.
+    private int Limite = ushort.MaxValue - 1;
+    private bool SinRecord;
+
     public PokeathlonEventRecord4Editor()
     {
         InitializeComponent();
+        NUD_Record.ValueChanged += (_, _) => AcotarAlTope();
+    }
+
+    /// <summary>Valor del cuadro tal como se guardaría: por encima del tope de la prueba se queda en el tope, salvo el «sin récord» que ya tenía.</summary>
+    private int ValorAcotado()
+    {
+        var valor = (int)NUD_Record.Value;
+        return valor > Limite && !(SinRecord && valor == ushort.MaxValue) ? Limite : valor;
+    }
+
+    private void AcotarAlTope()
+    {
+        var valor = ValorAcotado();
+        if (valor != (int)NUD_Record.Value)
+            NUD_Record.Value = valor;
     }
 
-    public void LoadObject(PokeathlonEventRecord4 entity)
+    public void LoadObject(PokeathlonEventRecord4 entity, PokeathlonEvent4 prueba)
     {
+        var tope = TopesJuego.PokeathlonRecordBruto(prueba);
+        SinRecord = entity.Record == ushort.MaxValue;
+        Limite = SinRecord ? tope : Math.Max(tope, entity.Record); // un valor ya guardado por encima del tope no se recorta al abrir
         NUD_Record.Value = Math.Clamp(entity.Record, (ushort)0, (ushort)NUD_Record.Maximum);
         UC_Entry0.LoadValues(entity.Entry0.Species, entity.Entry0.Form);
         UC_Entry1.LoadValues(entity.Entry1.Species, entity.Entry1.Form);
@@ -21,7 +45,7 @@ public void LoadObject(PokeathlonEventRecord4 entity)
 
     public void SaveObject(PokeathlonEventRecord4 entity)
     {
-        entity.Record = (ushort)NUD_Record.Value;
+        entity.Record = (ushort)ValorAcotado();
         entity.Entry0 = new SpeciesForm10 { Species = UC_Entry0.Species, Form = UC_Entry0.Form };
         entity.Entry1 = new SpeciesForm10 { Species = UC_Entry1.Species, Form = UC_Entry1.Form };
         entity.Entry2 = new SpeciesForm10 { Species = UC_Entry2.Species, Form = UC_Entry2.Form };
