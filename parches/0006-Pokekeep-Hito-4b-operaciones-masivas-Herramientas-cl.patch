         if (_pkMenuOptimize is not null) { _pkMenuOptimize.Enabled = av.Enabled; _pkMenuOptimize.ToolTipText = tipOptimize; }
     }
 
+    /// <summary>Hito 4b: activa o desactiva «Completar el juego…» y «Edición masiva…» con el motivo como ayuda (Colosseum, sin partida, operación en curso...).</summary>
+    private void UpdatePokekeepBulkAvailability()
+    {
+        if (_pkMenuComplete is null || _pkMenuBulk is null)
+            return;
+        var complete = Pokekeep.LivingDexAvailability();
+        _pkMenuComplete.Enabled = complete.Enabled;
+        _pkMenuComplete.ToolTipText = complete.Enabled ? "Genera todos los Pokémon de este juego, legales, al nivel máximo y en español, solo en casillas libres. Se puede deshacer de una vez." : complete.Reason ?? string.Empty;
+        var bulk = Pokekeep.BulkEditAvailability();
+        _pkMenuBulk.Enabled = bulk.Enabled;
+        _pkMenuBulk.ToolTipText = bulk.Enabled ? "Mejora stats, nivel, amistad, idioma y más de todas las cajas, de las que elijas o de los Pokémon que marques, comprobando cada uno con PKHeX." : bulk.Reason ?? string.Empty;
+    }
