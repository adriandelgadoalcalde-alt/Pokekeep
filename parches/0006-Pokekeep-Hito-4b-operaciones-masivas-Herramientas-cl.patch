index 8f43af8f1..16d83e599 100644
--- a/PKHeX.WinForms/Controls/SAV Editor/BoxMenuStrip.cs	
+++ b/PKHeX.WinForms/Controls/SAV Editor/BoxMenuStrip.cs	
@@ -1,6 +1,8 @@
 using System.Collections.Generic;
 using System.Drawing;
 using System.Windows.Forms;
+using AutoLegalidad.Ui;
+using AutoLegalidad.Ui.Bulk;
 using PKHeX.Core;
 using PKHeX.WinForms.Properties;
 
@@ -28,6 +30,36 @@ public BoxMenuStrip(SAVEditor sav)
                 AddItem(sav, parent, item);
             Items.Add(parent);
         }
+        AddPokekeepItems();
+    }
+
+    // Pokekeep (Hito 4b): operaciones masivas sobre la caja con clic derecho. Se distinguen de «Modificar > Nivel máximo / Amistad máxima» de PKHeX (que no comprueban la legalidad) por el nombre «Pokekeep».
+    private readonly ToolStripMenuItem mnuPokekeepBox = new() { Name = "mnu_PokekeepEdicionCaja", Text = Textos.EdicionMasiva + " de esta caja…" };
+    private readonly ToolStripMenuItem mnuPokekeepAllBoxes = new() { Name = "mnu_PokekeepEdicionTodas", Text = Textos.EdicionMasiva + " de todas las cajas…" };
+    private readonly ToolStripMenuItem mnuPokekeepComplete = new() { Name = "mnu_PokekeepCompletar", Text = Textos.CompletarElJuego + "…" };
+
+    private void AddPokekeepItems()
+    {
+        var parent = new ToolStripMenuItem { Name = "mnu_Pokekeep", Text = Textos.MenuPokekeep, Image = Resources.wand };
+        mnuPokekeepBox.Click += (_, _) => Pokekeep.RunBulkEdit(BulkScopeKind.Boxes, null, SAV.CurrentBox);
+        mnuPokekeepAllBoxes.Click += (_, _) => Pokekeep.RunBulkEdit(BulkScopeKind.All);
+        mnuPokekeepComplete.Click += (_, _) => Pokekeep.RunLivingDex();
+        parent.DropDownItems.AddRange([mnuPokekeepBox, mnuPokekeepAllBoxes, mnuPokekeepComplete]);
+        Items.Add(parent);
+        Opening += (_, _) => UpdatePokekeepItems();
+    }
+
+    private void UpdatePokekeepItems()
+    {
+        var bulk = Pokekeep.BulkEditAvailability();
+        foreach (var item in new[] { mnuPokekeepBox, mnuPokekeepAllBoxes })
+        {
+            item.Enabled = bulk.Enabled;
+            item.ToolTipText = bulk.Enabled ? string.Empty : bulk.Reason;
+        }
+        var complete = Pokekeep.LivingDexAvailability();
+        mnuPokekeepComplete.Enabled = complete.Enabled;
+        mnuPokekeepComplete.ToolTipText = complete.Enabled ? string.Empty : complete.Reason;
     }
 
     private void AddItem(ISaveFileProvider sav, ToolStripDropDownItem parent, IBoxManip item)
