         if (Application.IsDarkModeEnabled)
             WinFormsUtil.InvertToolStripIcons(mnuVSD.Items);
     }
@@ -157,12 +163,12 @@ private void MenuOpening(object sender, CancelEventArgs e)
         // Pokekeep: la casilla queda fijada AQUI. Desactivadas (con el motivo como ayuda) si esta vacia, bloqueada o el destino es desconocido.
         _pokekeepSlot = info.Slot;
         var pokekeep = Pokekeep.SlotAvailability(info.Slot);
-        foreach (var item in new[] { mnuPokekeepLegalize, mnuPokekeepOptimize })
+        foreach (var item in new[] { mnuPokekeepLegalize, mnuPokekeepOptimize, mnuPokekeepBulk })
         {
             item.Enabled = pokekeep.Enabled;
-            item.ToolTipText = pokekeep.Enabled ? (item == mnuPokekeepLegalize ? Textos.LegalizarTooltip : Textos.OptimizarTooltip) : pokekeep.Reason;
