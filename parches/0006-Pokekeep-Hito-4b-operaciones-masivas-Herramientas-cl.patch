 .../Controls/SAV Editor/ContextMenuSAV.cs     | 14 +++++---
 PKHeX.WinForms/Pokekeep/Main.Pokekeep.cs      | 23 ++++++++++++-
 .../Pokekeep/PokekeepIntegration.cs           | 11 +++++++
 PKHeX.WinForms/Resources/text/lang_en.txt     |  3 ++
 PKHeX.WinForms/Resources/text/lang_es-419.txt |  3 ++
 PKHeX.WinForms/Resources/text/lang_es.txt     |  3 ++
 7 files changed, 84 insertions(+), 5 deletions(-)

