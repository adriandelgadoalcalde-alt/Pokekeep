+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Windows.Forms;
+using AutoLegalidad.Desafios;
+using AutoLegalidad.Ui.Desafios;
+using PKHeX.Core;
+
+namespace PKHeX.WinForms;
+
+/// <summary>
+/// Pokekeep (R-013): puntos de integración de los desafíos al máximo en los formularios de PKHeX. La lógica vive en AutoLegalidad.Desafios y los controles en AutoLegalidad.Ui.Desafios;
+/// aquí solo se alojan en los formularios que ya editan rachas (pestaña «Desafíos») y se abre el formulario nuevo de lo que no tenía editor.
+/// </summary>
+internal static class PokekeepDesafios
+{
+    /// <summary>true si el idioma de PKHeX es el español (el desafío sigue al selector de idioma de PKHeX, no a la configuración de Pokekeep).</summary>
+    public static bool Espanol => TextosDesafiosUi.EsEspanol(Main.CurrentLanguage);
+
+    /// <summary>
+    /// Añade al final del <paramref name="tabs"/> una pestaña «Desafíos» con los botones «Ir al jefe» y «Máximo» de las instalaciones que cumplan <paramref name="filtro"/>.
+    /// <paramref name="antes"/> vuelca a la partida lo que el formulario lleva en sus controles; <paramref name="despues"/> los vuelve a leer para enseñar los valores nuevos.
+    /// </summary>
+    public static PanelDesafios? AgregarPestana(TabControl tabs, SaveFile sav, Func<InstalacionDesafio, bool> filtro, Action? antes, Action? despues)
+    {
+        var instalaciones = CatalogoDesafios.Para(sav).Where(filtro).ToList();
+        if (instalaciones.Count == 0)
+            return null;
+        var es = Espanol;
+        var panel = new PanelDesafios(() => sav, instalaciones, es, editable: false, antes, despues);
+        var pagina = new TabPage(TextosDesafiosUi.Desafios(es)) { Name = "Tab_PokekeepDesafios", UseVisualStyleBackColor = true, Padding = new System.Windows.Forms.Padding(4) };
+        pagina.Controls.Add(panel);
+        tabs.TabPages.Add(pagina);
+        // Los formularios de PKHeX son pequeños: con la pestaña nueva se agranda el cuadro hasta un tamaño en el que quepan los botones sin recortes.
+        if (tabs.FindForm() is { } form)
+            form.ClientSize = new System.Drawing.Size(Math.Max(form.ClientSize.Width, 700), Math.Max(form.ClientSize.Height, 480));
+        return panel;
+    }
+
+    /// <summary>Abre el formulario de desafíos que PKHeX no tenía (Torre de DBPR, PWT, PB del Metro, Colina Entrenador, Maison, Árbol Batalla, Torre de EpEs y Royale de Z-A).</summary>
+    public static Form? CrearFormulario(SaveFile sav) => FormDesafios.Aplica(sav) ? new FormDesafios(sav, Espanol) : null;
+
+    public static bool Disponible(SaveFile sav) => FormDesafios.Aplica(sav);
+
+    public static string TextoBoton => TextosDesafiosUi.DesafiosPuntos(Espanol);
+}
