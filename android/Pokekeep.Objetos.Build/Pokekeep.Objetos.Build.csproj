<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generador del paquete de objetos adicionales (X14): MT/MO/DR con el icono de su tipo y los objetos que PKHeX no dibuja, desde PokeAPI/sprites en una revisión FIJADA.
       X27 añade pret para Esmeralda y FR/LG: gráfico y paleta por id nativo, sin escalado (solo PLTE y CRC). Las demás fuentes se conservan byte a byte.
       Empaqueta en objetos.pkpack + manifest.json (mismo formato que los sprites) + procedencia, y escribe el informe de cobertura por juego.
       Uso: herramientas\generar-objetos-android.ps1 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pokekeep.Objetos.Build</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pokekeep.Sprites\Pokekeep.Sprites.csproj" />
    <InternalsVisibleTo Include="Pokekeep.Sprites.Tests" />
    <EmbeddedResource Include="alias-nombres.tsv" LogicalName="alias-nombres.tsv" />
    <EmbeddedResource Include="alias-modernos.tsv" LogicalName="alias-modernos.tsv" />
    <EmbeddedResource Include="pret-gen3.tsv" LogicalName="pret-gen3.tsv" />
  </ItemGroup>
</Project>
