<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:Pokekeep.Mobile.Ui.Design">
  <!-- Sistema de diseno Pokekeep, direccion «Nitida unificada» (02-DISENO-DE-LA-APP.md de Codex). Tokens claro/oscuro, escala 4/8/12/16/24/32,
       tarjetas 20, campos y botones 12, insignias rectangulares de radio 8 (Patrones-UI-validados). Los ajustes de contraste AA se documentan en docs\android\sistema-de-diseno.md. -->
