<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:Pokekeep.Mobile.Ui.Design"
             xmlns:v="clr-namespace:Pokekeep.Mobile.Ui.Views"
             xmlns:i="clr-namespace:Pokekeep.Mobile.Ui.Herramientas.Integridad"
             x:Class="Pokekeep.Mobile.Ui.Views.IntegridadView"
             x:DataType="i:IntegridadViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16,0,16,24" Spacing="10">
      <Button Classes="texto" HorizontalAlignment="Left" Command="{Binding VolverCommand}" Padding="8,0" AutomationProperties.Name="{DynamicResource Loc.ImportarHex.VolverHerramientas}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><d:Icono Glifo="ArrowLeft" Width="20" Height="20" VerticalAlignment="Center" /><d:TextoEntero Grid.Column="1" Text="{DynamicResource Loc.ImportarHex.VolverHerramientas}" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
      </Button>
      <StackPanel Spacing="2" Margin="0,4,0,4">
        <TextBlock Classes="titulo" Text="{Binding Titulo}" />
        <TextBlock Classes="sec" TextWrapping="Wrap" Text="{Binding Subtitulo}" />
      </StackPanel>

      <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.Integridad.SumasVerificacion}" />
      <Border Classes="tarjeta" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Classes="sec" TextWrapping="Wrap" Text="{DynamicResource Loc.Integridad.CadaBloqueGuardadoLleva}" />
          <Button Classes="primario" HorizontalAlignment="Stretch" Command="{Binding ComprobarSumasCommand}" AutomationProperties.Name="{DynamicResource Loc.Integridad.ComprobarSumasVerificacion}">
            <TextBlock Text="{DynamicResource Loc.Integridad.ComprobarSumas}" TextAlignment="Center" TextWrapping="Wrap" />
          </Button>
          <Border Classes="insignia" Classes.ok="{Binding SumasOk}" Classes.aviso="{Binding SumasAviso}" Classes.error="{Binding SumasError}" Padding="12,8" IsVisible="{Binding HayResultadoSumas}">
            <TextBlock Text="{Binding TextoSumas}" TextWrapping="Wrap" FontWeight="Bold" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding CopiarDetalleSumasCommand}" IsVisible="{Binding HayDetalleSumas}" AutomationProperties.Name="{DynamicResource Loc.Integridad.CopiarDetalleSumas}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><d:Icono Glifo="ClipboardCopy" Width="20" Height="20" /><TextBlock Text="{DynamicResource Loc.Integridad.CopiarDetalle}" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.Integridad.PokemonGuardados}" />
      <Border Classes="tarjeta" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Classes="sec" TextWrapping="Wrap" Text="{DynamicResource Loc.Integridad.CompruebaLegalidadTodosPokemon}" />
          <Button Classes="primario" HorizontalAlignment="Stretch" Command="{Binding VerificarTodosCommand}" IsEnabled="{Binding NoOcupado}" AutomationProperties.Name="{DynamicResource Loc.Integridad.VerificarTodosPokemon}">
            <TextBlock Text="{DynamicResource Loc.Integridad.VerificarTodosPokemon}" TextAlignment="Center" TextWrapping="Wrap" />
          </Button>
          <StackPanel Spacing="6" IsVisible="{Binding Ocupado}">
            <ProgressBar IsIndeterminate="{Binding FraccionIndeterminada}" Value="{Binding Fraccion}" Minimum="0" Maximum="100" AutomationProperties.Name="{DynamicResource Loc.Integridad.ProgresoVerificacion}" />
            <TextBlock Classes="sec" Text="{Binding TextoAvance}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding CancelarCommand}" AutomationProperties.Name="{DynamicResource Loc.Integridad.CancelarVerificacion}"><TextBlock Text="{DynamicResource Loc.Comun.Cancelar}" TextAlignment="Center" /></Button>
          </StackPanel>
          <Border Classes="insignia" Classes.ok="{Binding VerificacionOk}" Classes.error="{Binding VerificacionError}" Padding="12,8" IsVisible="{Binding HayResultadoVerificacion}">
            <TextBlock Text="{Binding TextoVerificacion}" TextWrapping="Wrap" FontWeight="Bold" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <v:TablaResultadosView DataContext="{Binding Tabla}" IsVisible="{Binding $parent[UserControl].((i:IntegridadViewModel)DataContext).HayTabla}" />
          <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding CopiarInformeCommand}" IsVisible="{Binding HayInforme}" AutomationProperties.Name="{DynamicResource Loc.InformeMasivo.CopiarInforme}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><d:Icono Glifo="ClipboardCopy" Width="20" Height="20" /><TextBlock Text="{DynamicResource Loc.InformeMasivo.CopiarInforme}" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <TextBlock Classes="sec" Text="{Binding Copiado}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
