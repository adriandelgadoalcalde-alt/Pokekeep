<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:Pokekeep.Mobile.Ui.Design"
             xmlns:vm="clr-namespace:Pokekeep.Mobile.Ui.ViewModels"
             x:Class="Pokekeep.Mobile.Ui.Views.DisenoCajaHojaView"
             x:DataType="vm:DisenoCajaHojaViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14" Margin="20,4,20,24">
      <!-- Caja que se edita -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="texto" Command="{Binding CajaAnteriorCommand}" AutomationProperties.Name="{DynamicResource Loc.Cajas.CajaAnterior}"><d:Icono Glifo="ChevronLeft" /></Button>
        <TextBlock Grid.Column="1" Text="{Binding Posicion}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" AutomationProperties.LiveSetting="Polite" />
        <Button Grid.Column="2" Classes="texto" Command="{Binding CajaSiguienteCommand}" AutomationProperties.Name="{DynamicResource Loc.Cajas.CajaSiguiente}"><d:Icono Glifo="ChevronRight" /></Button>
      </Grid>

      <!-- Nombre -->
      <StackPanel Spacing="6" IsVisible="{Binding AdmiteNombres}">
        <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.DisenoCajaHoja.NOMBRE}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Classes="campo" Text="{Binding Nombre}" MaxLength="{Binding MaxNombre}" AutomationProperties.Name="{DynamicResource Loc.DisenoCajaHoja.NombreCaja}" AutomationProperties.HelpText="{DynamicResource Loc.DisenoCajaHoja.HastaMaximoLetrasAdmite}" />
          <Button Grid.Column="1" Classes="primario" Command="{Binding AplicarNombreCommand}" IsEnabled="{Binding NombreCambiado}" MinWidth="96" AutomationProperties.Name="{DynamicResource Loc.DisenoCajaHoja.AplicarNombre}">
            <TextBlock Text="{DynamicResource Loc.Editor.Aplicar}" TextAlignment="Center" />
          </Button>
        </Grid>
      </StackPanel>
      <TextBlock Classes="sec" Text="{DynamicResource Loc.DisenoCajaHoja.PartidaPermiteCambiarNombres}" IsVisible="{Binding SoloLecturaDeNombres}" />

      <!-- Fondo -->
      <StackPanel Spacing="6" IsVisible="{Binding AdmiteFondos}">
        <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.DisenoCajaHoja.FONDO}" />
        <ItemsControl ItemsSource="{Binding Fondos}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilaFondo">
              <Button Classes="fila" Command="{Binding $parent[UserControl].((vm:DisenoCajaHojaViewModel)DataContext).ElegirFondoCommand}" CommandParameter="{Binding}" Width="{DynamicResource AnchoOpcionFondo}" MinWidth="88" MinHeight="72" Margin="0,0,8,8" AutomationProperties.Name="{Binding Accesible}">
                <Border BorderThickness="2" BorderBrush="Transparent" Classes.sel="{Binding Elegido}" CornerRadius="10" Padding="2">
                  <Border.Styles><Style Selector="Border.sel"><Setter Property="BorderBrush" Value="{DynamicResource Dorado}" /></Style></Border.Styles>
                  <StackPanel Spacing="4">
                    <Grid Width="76" Height="58" HorizontalAlignment="Center">
                    <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SuperficieHundida}" Width="76" Height="58">
                      <Image Source="{Binding Miniatura}" Stretch="UniformToFill" IsVisible="{Binding HayMiniatura}" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <Border Classes="insignia dorado" Padding="0" Width="20" Height="20" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" IsVisible="{Binding Elegido}"><d:Icono Glifo="Check" Width="14" Height="14" /></Border>
                    </Grid>
                    <TextBlock Text="{Binding Nombre}" FontSize="{DynamicResource TamMini}" HorizontalAlignment="Stretch" TextTrimming="None" TextWrapping="Wrap" TextAlignment="Center" Padding="4,2" Foreground="{DynamicResource Texto}" Background="{DynamicResource Superficie}" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Mover la caja y cajas desbloqueadas -->
      <StackPanel Spacing="6" IsVisible="{Binding AdmiteMover}">
        <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.DisenoCajaHoja.POSICION}" />
        <d:RejillaSinPartir Columns="2" ColumnSpacing="8" RowSpacing="8">
          <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding MoverArribaCommand}" AutomationProperties.Name="{DynamicResource Loc.DisenoCajaHoja.MoverCajaAntes}" AutomationProperties.HelpText="{DynamicResource Loc.DisenoCajaHoja.IntercambiaCajaAnteriorContenido}">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><d:Icono Glifo="ChevronLeft" Width="20" Height="20" /><TextBlock Text="{DynamicResource Loc.DisenoCajaHoja.Antes}" /></StackPanel>
          </Button>
          <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding MoverAbajoCommand}" AutomationProperties.Name="{DynamicResource Loc.DisenoCajaHoja.MoverCajaDespues}" AutomationProperties.HelpText="{DynamicResource Loc.DisenoCajaHoja.IntercambiaCajaSiguienteContenido}">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><TextBlock Text="{DynamicResource Loc.DisenoCajaHoja.Despues}" /><d:Icono Glifo="ChevronRight" Width="20" Height="20" /></StackPanel>
          </Button>
        </d:RejillaSinPartir>
      </StackPanel>
      <StackPanel Spacing="6" IsVisible="{Binding AdmiteDesbloqueo}">
        <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.DisenoCajaHoja.CAJASDESBLOQUEADAS}" />
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Classes="icono" Width="48" Height="48" Command="{Binding MenosDesbloqueadasCommand}" AutomationProperties.Name="{DynamicResource Loc.DisenoCajaHoja.CajaMenosDesbloqueada}"><d:Icono Glifo="Minus" /></Button>
          <TextBlock Grid.Column="1" Text="{Binding TextoDesbloqueadas}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <Button Grid.Column="2" Classes="icono" Width="48" Height="48" Command="{Binding MasDesbloqueadasCommand}" AutomationProperties.Name="{DynamicResource Loc.DisenoCajaHoja.CajaDesbloqueada}"><d:Icono Glifo="Plus" /></Button>
        </Grid>
      </StackPanel>
      <Button Classes="primario" HorizontalAlignment="Stretch" Command="{Binding CerrarCommand}" AutomationProperties.Name="{DynamicResource Loc.Comun.Listo}"><TextBlock Text="{DynamicResource Loc.Comun.Listo}" TextAlignment="Center" /></Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
