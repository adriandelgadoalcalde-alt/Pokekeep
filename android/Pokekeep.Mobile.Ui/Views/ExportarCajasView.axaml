<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:Pokekeep.Mobile.Ui.Design"
             xmlns:h="clr-namespace:Pokekeep.Mobile.Ui.Herramientas.ExportarCajas"
             x:Class="Pokekeep.Mobile.Ui.Views.ExportarCajasView"
             x:DataType="h:ExportarCajasViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="h:OpcionExportacion">
      <Button Classes="fila" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="56" Command="{Binding AbrirCommand}" AutomationProperties.Name="{Binding Accesible}">
        <d:EtiquetaYValor Separacion="0">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="sec" Text="{Binding Valor}" TextWrapping="Wrap" />
            <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
          <d:Icono Glifo="ChevronRight" Width="20" Height="20" VerticalAlignment="Center" Margin="8,0,0,0" />
        </d:EtiquetaYValor>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16,0,16,24" Spacing="10">
      <Button Classes="texto" HorizontalAlignment="Left" Command="{Binding VolverCommand}" Padding="8,0" AutomationProperties.Name="{DynamicResource Loc.Menu.Volver}">
        <StackPanel Orientation="Horizontal" Spacing="8"><d:Icono Glifo="ArrowLeft" Width="20" Height="20" /><TextBlock Text="{DynamicResource Loc.Menu.Volver}" /></StackPanel>
      </Button>
      <StackPanel Spacing="2" Margin="0,4,0,4">
        <TextBlock Classes="titulo" Text="{Binding Titulo}" />
        <TextBlock Classes="sec" TextWrapping="Wrap" Text="{Binding Subtitulo}" />
      </StackPanel>

      <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.ExportarCajas.Opciones}" />
      <Border Classes="tarjeta" Padding="6,4">
        <StackPanel Spacing="2">
          <ItemsControl ItemsSource="{Binding Opciones}" />
          <ContentControl Content="{Binding Nombrador}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="etiqueta" Text="{DynamicResource Loc.ExportarCajas.VaExportar}" />
      <Border Classes="tarjeta" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Resumen}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <ItemsControl ItemsSource="{Binding Ejemplos}" IsVisible="{Binding HayEjemplos}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="sec" Text="{Binding}" TextWrapping="Wrap" FontFamily="monospace" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="primario" HorizontalAlignment="Stretch" Command="{Binding ExportarCommand}" IsEnabled="{Binding NoOcupado}" AutomationProperties.Name="{DynamicResource Loc.ExportarCajas.ExportarCarpeta}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><d:Icono Glifo="FolderOpen" Width="20" Height="20" VerticalAlignment="Center" /><d:TextoEntero Grid.Column="1" Text="{DynamicResource Loc.ExportarCajas.ExportarCarpeta2}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" /></Grid>
          </Button>
          <TextBlock Classes="sec" Text="{Binding MotivoExportar}" TextWrapping="Wrap" IsVisible="{Binding !PuedeExportar}" />
          <StackPanel Spacing="6" IsVisible="{Binding Ocupado}">
            <ProgressBar IsIndeterminate="{Binding FraccionIndeterminada}" Value="{Binding Fraccion}" Minimum="0" Maximum="100" AutomationProperties.Name="{DynamicResource Loc.ExportarCajas.ProgresoExportacion}" />
            <TextBlock Classes="sec" Text="{Binding TextoAvance}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding CancelarCommand}" AutomationProperties.Name="{DynamicResource Loc.ExportarCajas.CancelarExportacion}"><TextBlock Text="{DynamicResource Loc.Comun.Cancelar}" TextAlignment="Center" /></Button>
          </StackPanel>
          <Border Classes="insignia" Classes.ok="{Binding !MensajeEsError}" Classes.error="{Binding MensajeEsError}" Padding="12,8" IsVisible="{Binding HayMensaje}">
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="Bold" AutomationProperties.LiveSetting="Polite" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
