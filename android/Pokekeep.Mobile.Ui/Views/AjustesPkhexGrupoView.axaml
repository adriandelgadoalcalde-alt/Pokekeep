<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Pokekeep.Mobile.Ui.Localizacion"
             xmlns:d="clr-namespace:Pokekeep.Mobile.Ui.Design"
             xmlns:vm="clr-namespace:Pokekeep.Mobile.Ui.ViewModels"
             x:Class="Pokekeep.Mobile.Ui.Views.AjustesPkhexGrupoView"
             x:DataType="vm:AjustesPkhexGrupoViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16,0,16,24" Spacing="10">
      <Button Classes="texto" HorizontalAlignment="Left" Command="{Binding VolverCommand}" Padding="8,0" AutomationProperties.Name="{DynamicResource Loc.Ajustes.Pkhex.Volver}">
        <StackPanel Orientation="Horizontal" Spacing="8"><d:Icono Glifo="ArrowLeft" Width="20" Height="20" /><TextBlock Text="{DynamicResource Loc.Ajustes.Pkhex.Volver}" /></StackPanel>
      </Button>
      <StackPanel Spacing="2" Margin="0,4,0,4">
        <TextBlock Classes="titulo" Text="{Binding Titulo}" />
        <TextBlock Classes="sec" TextWrapping="Wrap" Text="{Binding Subtitulo}" />
      </StackPanel>
      <Border Classes="tarjeta" Padding="14,6">
        <ItemsControl ItemsSource="{Binding Filas}">
          <ItemsControl.DataTemplates>
            <DataTemplate x:DataType="vm:FilaPkhexInterruptor">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <d:EtiquetaYValor Separacion="0">
                  <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ToggleButton HorizontalAlignment="Left" Classes="chip" IsChecked="{Binding Activo}" MinWidth="64" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{Binding Descripcion}"><TextBlock Text="{Binding ValorTexto}" /></ToggleButton>
                </d:EtiquetaYValor>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexEntero">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <d:EtiquetaYValor Separacion="4">
                  <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                    <Button Classes="icono" Width="48" Height="48" Command="{Binding BajarCommand}" IsEnabled="{Binding PuedeBajar}" AutomationProperties.Name="{l:Formato Ajustes.Bajar, {Binding Nombre}}"><d:Icono Glifo="Minus" /></Button>
                    <TextBlock Text="{Binding ValorTexto}" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" AutomationProperties.Name="{l:Formato Ajustes.Valor, {Binding ValorTexto}}" />
                    <Button Classes="icono" Width="48" Height="48" Command="{Binding SubirCommand}" IsEnabled="{Binding PuedeSubir}" AutomationProperties.Name="{l:Formato Ajustes.Subir, {Binding Nombre}}"><d:Icono Glifo="Plus" /></Button>
                  </StackPanel>
                </d:EtiquetaYValor>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexDecimal">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <d:EtiquetaYValor Separacion="4">
                  <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                    <Button Classes="icono" Width="48" Height="48" Command="{Binding BajarCommand}" IsEnabled="{Binding PuedeBajar}" AutomationProperties.Name="{l:Formato Ajustes.Bajar, {Binding Nombre}}"><d:Icono Glifo="Minus" /></Button>
                    <TextBlock Text="{Binding ValorTexto}" MinWidth="52" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" AutomationProperties.Name="{l:Formato Ajustes.Valor, {Binding ValorTexto}}" />
                    <Button Classes="icono" Width="48" Height="48" Command="{Binding SubirCommand}" IsEnabled="{Binding PuedeSubir}" AutomationProperties.Name="{l:Formato Ajustes.Subir, {Binding Nombre}}"><d:Icono Glifo="Plus" /></Button>
                  </StackPanel>
                </d:EtiquetaYValor>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexOpcion">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <Button Classes="secundario" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AbrirCommand}" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{Binding Descripcion}">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ValorTexto}" TextWrapping="Wrap" VerticalAlignment="Center" /><d:Icono Grid.Column="1" Glifo="ChevronDown" Width="18" Height="18" /></Grid>
                </Button>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexNombrador">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <Button Classes="secundario" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AbrirCommand}" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{Binding Descripcion}">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ValorTexto}" TextWrapping="Wrap" VerticalAlignment="Center" /><d:Icono Grid.Column="1" Glifo="ChevronDown" Width="18" Height="18" /></Grid>
                </Button>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexTexto">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBox Text="{Binding Texto}" LostFocus="AlPerderFoco" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{Binding Descripcion}" />
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <!-- Bloque 10-1: carpetas de trabajo (SAF), idioma y versión de la partida en blanco -->
            <DataTemplate x:DataType="vm:FilaPkhexCarpeta">
              <StackPanel Spacing="6" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <d:Icono Glifo="FolderOpen" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource Dorado}" />
                  <d:TextoEntero Grid.Column="1" Text="{Binding Actual}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="{l:Formato Ajustes.Pkhex.CarpetaActual, {Binding Actual}}" />
                </Grid>
                <!-- «Quitar mi carpeta» solo existe con una carpeta elegida: sin ella no hay nada que quitar, y un botón apagado que hablaba de «la de la app» daba a entender que faltaba algo. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding ElegirCommand}" IsEnabled="{Binding PuedeElegir}" AutomationProperties.Name="{l:Formato Ajustes.Pkhex.ElegirCarpetaAccesible, {Binding Nombre}}"><TextBlock Text="{DynamicResource Loc.Ajustes.Pkhex.ElegirCarpeta}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                  <Button Grid.Column="1" Classes="secundario" Command="{Binding UsarLaDeLaAppCommand}" IsVisible="{Binding HayEnlace}" AutomationProperties.Name="{l:Formato Ajustes.Pkhex.QuitarCarpetaAccesible, {Binding Nombre}}"><TextBlock Text="{DynamicResource Loc.Ajustes.Pkhex.QuitarCarpeta}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                </Grid>
                <TextBlock Classes="sec" Text="{Binding Estado}" TextWrapping="Wrap" IsVisible="{Binding HayEstado}" />
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexIdioma">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <Button Classes="secundario" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AbrirCommand}" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{Binding Descripcion}">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ValorTexto}" TextWrapping="Wrap" VerticalAlignment="Center" /><d:Icono Grid.Column="1" Glifo="ChevronDown" Width="18" Height="18" /></Grid>
                </Button>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexVersionBlanco">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <Button Classes="secundario" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AbrirCommand}" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{Binding Descripcion}">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ValorTexto}" TextWrapping="Wrap" VerticalAlignment="Center" /><d:Icono Grid.Column="1" Glifo="ChevronDown" Width="18" Height="18" /></Grid>
                </Button>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <!-- Bloque 10-4: «Otras rutas de copias» (carpetas del selector del sistema) y «Otras extensiones de partidas» (separadas por comas) -->
            <DataTemplate x:DataType="vm:FilaPkhexCarpetasExtra">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
                <TextBlock Classes="sec" Text="{DynamicResource Loc.Ajustes.Pkhex.NingunaCarpeta}" IsVisible="{Binding !HayCarpetas}" />
                <ItemsControl ItemsSource="{Binding Carpetas}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CarpetaExtra">
                      <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                        <d:Icono Glifo="FolderOpen" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Nombre}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="icono" Command="{Binding Quitar}" AutomationProperties.Name="{l:Formato Ajustes.Pkhex.QuitarAccesible, {Binding Nombre}}">
                          <d:Icono Glifo="Trash2" Width="20" Height="20" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding AnadirCommand}" AutomationProperties.Name="{DynamicResource Loc.Ajustes.Pkhex.AnadirCarpeta}" AutomationProperties.HelpText="{DynamicResource Loc.Ajustes.Pkhex.BuscarGuardados}">
                  <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" ColumnSpacing="8"><d:Icono Glifo="FolderOpen" Width="20" Height="20" /><d:TextoEntero Grid.Column="1" Text="{DynamicResource Loc.Ajustes.Pkhex.AnadirCarpetaTexto}" TextWrapping="Wrap" /></Grid>
                </Button>
                <TextBlock Classes="sec" Text="{Binding Aviso}" TextWrapping="Wrap" IsVisible="{Binding HayAviso}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexExtensiones">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBox Text="{Binding Texto}" PlaceholderText="{DynamicResource Loc.Ajustes.Pkhex.ExtensionesEjemplo}" LostFocus="AlPerderFoco" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{DynamicResource Loc.Ajustes.Pkhex.ExtensionesAyuda}" />
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <!-- Bloque 10-7: «Propiedades adicionales» y «Propiedades ocultas» del informe (listas que se eligen, no se escriben) -->
            <DataTemplate x:DataType="vm:FilaPkhexPropiedadesInforme">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
                <TextBlock Classes="sec" Text="{DynamicResource Loc.Ajustes.Pkhex.Ninguna}" IsVisible="{Binding !HayElegidas}" />
                <ItemsControl ItemsSource="{Binding Elegidas}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropiedadElegida">
                      <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icono" Width="48" Height="48" Command="{Binding Quitar}" AutomationProperties.Name="{l:Formato Ajustes.Pkhex.QuitarAccesible, {Binding Texto}}">
                          <d:Icono Glifo="Trash2" Width="20" Height="20" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding AbrirAnadirCommand}" AutomationProperties.Name="{Binding TextoAnadir}">
                  <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" ColumnSpacing="8"><d:Icono Glifo="Plus" Width="20" Height="20" /><d:TextoEntero Grid.Column="1" Text="{Binding TextoAnadir}" TextWrapping="Wrap" /></Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexListaOpciones">
              <StackPanel Spacing="6" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Elementos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ElementoListaPkhex">
                      <d:EtiquetaYValor Separacion="4" MinHeight="48">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="4">
                          <TextBlock Text="{Binding Posicion}" Classes="sec" VerticalAlignment="Center" TextAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Etiqueta}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                          <Button Classes="icono" Width="48" Height="48" Command="{Binding SubirCommand}" IsEnabled="{Binding PuedeSubir}" AutomationProperties.Name="{Binding AccesibleSubir}"><d:Icono Glifo="ChevronUp" /></Button>
                          <Button Classes="icono" Width="48" Height="48" Command="{Binding BajarCommand}" IsEnabled="{Binding PuedeBajar}" AutomationProperties.Name="{Binding AccesibleBajar}"><d:Icono Glifo="ChevronDown" /></Button>
                          <Button Classes="icono" Width="48" Height="48" Command="{Binding QuitarCommand}" AutomationProperties.Name="{Binding AccesibleQuitar}"><d:Icono Glifo="X" /></Button>
                        </StackPanel>
                      </d:EtiquetaYValor>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding AnadirCommand}" IsEnabled="{Binding PuedeAnadir}" AutomationProperties.Name="{l:Formato Ajustes.Pkhex.AnadirLineaAccesible, {Binding Nombre}}"><TextBlock Text="{DynamicResource Loc.Ajustes.Pkhex.AnadirLinea}" TextAlignment="Center" /></Button>
                <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding ComoShowdownCommand}" AutomationProperties.Name="{l:Formato Ajustes.Pkhex.OrdenShowdownAccesible, {Binding Nombre}}"><TextBlock Text="{DynamicResource Loc.Ajustes.Pkhex.OrdenShowdown}" TextAlignment="Center" TextWrapping="Wrap" /></Button>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexColor">
              <StackPanel Spacing="6" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <Border Background="{Binding Muestra}" Height="36" CornerRadius="8" AutomationProperties.AccessibilityView="Raw" />
                <TextBox Text="{Binding Texto}" LostFocus="AlPerderFoco" AutomationProperties.Name="{Binding Nombre}" AutomationProperties.HelpText="{DynamicResource Loc.Ajustes.Pkhex.AyudaColor}" />
                <Button Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding ConfirmarCommand}" AutomationProperties.Name="{DynamicResource Loc.Ajustes.Pkhex.AplicarColor}"><TextBlock Text="{DynamicResource Loc.Ajustes.Pkhex.AplicarColor}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                <TextBlock Classes="sec" Text="{Binding Descripcion}" TextWrapping="Wrap" IsVisible="{Binding HayDescripcion}" />
                <TextBlock Classes="sec" Text="{Binding Aviso}" TextWrapping="Wrap" IsVisible="{Binding HayAviso}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate x:DataType="vm:FilaPkhexSinControl">
              <StackPanel Spacing="4" Margin="0,8" AutomationProperties.Name="{Binding Accesible}">
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Classes="sec" Text="{Binding ValorTexto}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </Border>
      <Button Name="BotonRestablecerGrupo" Classes="secundario" HorizontalAlignment="Stretch" Command="{Binding RestablecerCommand}" AutomationProperties.Name="{DynamicResource Loc.Ajustes.Pkhex.RestablecerGrupo}" AutomationProperties.HelpText="{DynamicResource Loc.Ajustes.Pkhex.RestablecerGrupoAyuda}">
        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" ColumnSpacing="8"><d:Icono Glifo="RefreshCw" Width="20" Height="20" /><d:TextoEntero Grid.Column="1" Text="{DynamicResource Loc.Ajustes.Pkhex.RestablecerGrupo}" TextWrapping="Wrap" TextAlignment="Center" /></Grid>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
