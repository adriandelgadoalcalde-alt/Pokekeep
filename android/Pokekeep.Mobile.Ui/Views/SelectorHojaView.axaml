<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:Pokekeep.Mobile.Ui.Design"
             xmlns:vm="clr-namespace:Pokekeep.Mobile.Ui.ViewModels"
             x:Class="Pokekeep.Mobile.Ui.Views.SelectorHojaView"
             x:DataType="vm:SelectorHojaViewModel">
  <Grid RowDefinitions="Auto,Auto,*" MinHeight="320">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="20,4,20,8">
      <d:Icono Glifo="Search" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource TextoSecundario}" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Classes="campo" Name="Buscador" Text="{Binding Filtro}" PlaceholderText="{Binding MarcadorBusqueda}" AutomationProperties.Name="{Binding MarcadorBusqueda}" />
    </Grid>
    <TextBlock Grid.Row="1" Classes="sec" Text="{Binding Resumen}" Margin="20,0,20,6" AutomationProperties.LiveSetting="Polite" />
    <ListBox Grid.Row="2" ItemsSource="{Binding Visibles}" Background="Transparent" Padding="8,0,8,16" AutomationProperties.Name="{DynamicResource Loc.Selector.Resultados}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Margin" Value="0" /></Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FilaSelector">
          <Button Classes="fila" Command="{Binding $parent[ListBox].((vm:SelectorHojaViewModel)DataContext).ElegirCommand}" CommandParameter="{Binding}" MinHeight="52" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Accesible}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
              <d:SpritePokemon Width="44" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding HayEspecie}" Especie="{Binding Especie}" Forma="{Binding Forma}" Foreground="{DynamicResource TextoSecundario}" />
              <Panel Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding TieneIconoObjeto}" AutomationProperties.AccessibilityView="Raw">
                <d:IconoObjetoImagen Source="{Binding IconoObjeto}" StretchDirection="DownOnly" AutomationProperties.AccessibilityView="Raw" />
                <d:Icono Glifo="Package" Width="26" Height="26" IsVisible="{Binding FaltaIconoObjeto}" Foreground="{DynamicResource TextoSecundario}" />
              </Panel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <d:TextoAjustado IsVisible="{Binding TieneIconoObjeto}" Text="{Binding Texto}" TamanoPreferido="{DynamicResource TamCuerpo}" FraccionMinima="0.7" FontWeight="Medium" TextWrapping="NoWrap" />
                <TextBlock IsVisible="{Binding !TieneIconoObjeto}" Text="{Binding Texto}" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Classes="sec" Text="{Binding Detalle}" IsVisible="{Binding SoloDetalle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2" IsVisible="{Binding HayTipo}">
                  <d:EtiquetaTipo Tipo="{Binding Tipo}" Texto="{Binding TipoTexto}" />
                  <TextBlock Classes="sec" Text="{Binding DetalleSinTipo}" IsVisible="{Binding HayDetalleSinTipo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
              </StackPanel>
              <d:Icono Grid.Column="2" Glifo="Check" Width="20" Height="20" Foreground="{DynamicResource Dorado}" IsVisible="{Binding Elegida}" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="{DynamicResource Loc.Selector.Vacio}" Classes="sec" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding SinResultados}" />
  </Grid>
</UserControl>
