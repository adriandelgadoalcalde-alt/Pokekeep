<Project>
  <!-- Fase 2 de Android (ADR 0056): los proyectos de android\ llevan sus propias propiedades. No importan las de la raiz (que solo valen para src\ y tests\) ni las de
       Directory.Packages.props de la raiz. El codigo propio de src\ que referencian se compila con -p:PokekeepAndroid=true (net10.0-android) desde el proyecto cabecera. -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ProyectoRaiz>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</ProyectoRaiz>
    <PKHeXCoreProject>$(ProyectoRaiz)fuentes\PKHeX-oficial\PKHeX.Core\PKHeX.Core.csproj</PKHeXCoreProject>
    <PKHeXRaiz>$(ProyectoRaiz)fuentes\PKHeX-oficial\</PKHeXRaiz>
    <SourceRevisionId>bfe89c74a3f5</SourceRevisionId>
    <!-- Versiones exactas (sin flotantes). -->
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
  </PropertyGroup>
</Project>
