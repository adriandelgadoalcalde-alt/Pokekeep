<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generador de atlas de sprites (F3): lee Resources.resx de PKHeX.Drawing.PokeSprite y empaqueta los PNG por familia + manifest.json. Uso: herramientas\generar-sprites-android.ps1 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pokekeep.Sprites.Build</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Solo para el generador (no viaja en el APK): decodifica los WebP sin perdida de la entrega X47 (SkiaSharp, MIT, el mismo que usa Avalonia). -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <ProjectReference Include="..\Pokekeep.Sprites\Pokekeep.Sprites.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pokekeep.Sprites.Tests" />
    <None Update="lgpe-caja-r1.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
