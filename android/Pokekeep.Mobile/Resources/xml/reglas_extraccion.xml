<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada de la app (sesiones, copias de seguridad, registros, datos) sale del dispositivo ni por copia en la nube ni por transferencia entre dispositivos. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
