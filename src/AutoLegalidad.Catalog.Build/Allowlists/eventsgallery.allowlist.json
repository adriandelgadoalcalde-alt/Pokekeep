{
  // Allowlist DOCUMENTADA de EventsGallery (Project Pokemon, sin licencia declarada: ADR 0005). Rutas relativas a la raiz del clon, con '/'.
  // Nunca se importa la raiz de forma recursiva: solo lo que una regla "import" permite se LEE de disco.
  // Resolucion: gana la regla mas especifica (ruta mas larga; a igualdad, "exclude" primero). Lo no cubierto queda fuera (NotInAllowlist).
  // Clasificacion (PLAN-TECNICO.md 8): AuthenticDump | DocumentedReconstruction | ResearchOnly | Unknown.
  // Para generar (regla 8) hace falta releaseState=Published + AuthenticDump|DocumentedReconstruction + parseo oficial correcto
  // + (si es reconstruccion) corroboracion byte a byte con el MGDB embebido del Core. Unreleased, Unknown y ResearchOnly NUNCA se aprueban.
  "source": "eventsgallery",
  // Sobrescrituras globales (se prueban contra la RUTA completa; solo pueden DEGRADAR una regla AuthenticDump).
  "globalOverrides": [
    { "pattern": "Simulated", "evidenceClass": "DocumentedReconstruction",
      "rationale": "Convencion del repositorio: 'Simulated' en el nombre de carpeta o de fichero (p. ej. 'HOME Simulated WCs', titulo 'This is a Dummy Card') marca una tarjeta simulada o reconstruida por la comunidad, no un volcado original." }
  ],
  "description": "EventsGallery (projectpokemon/EventsGallery) fijado por commit. Evidencia: README.md del repositorio (Released = eventos publicados; las tarjetas de Gen 4 sin original se reconstruyeron desde PGT con datos placeholder; la carpeta 'PKHeX Legality' contiene tarjetas alteradas solo para legalidad/generacion) y comprobacion cruzada con el Core.",
  "rules": [
    // ---------------- Exclusiones explicitas (se cuentan por regla; ni se leen ni se hashean) ----------------
    { "id": "X-UNRELEASED", "path": "Unreleased", "action": "exclude",
      "rationale": "Eventos NO publicados (pruebas internas, debug, QA): regla 8 de la entrega, nunca se importan para generar. Tampoco se leen." },
    { "id": "X-EXTRAS", "path": "Extras", "action": "exclude",
      "rationale": "Hojas de calculo y ZIP de seguimiento; no son plantillas de Pokemon." },
    { "id": "X-G3-ECARD", "path": "Released/Gen 3", "action": "exclude", "extensions": [".raw", ".ect", ".ecb", ".sav"],
      "rationale": "e-Reader raw, e-Trainer, e-Berry y una partida guardada: no son plantillas de Pokemon (los saves nunca se importan)." },
    { "id": "X-NOT-TEMPLATE", "path": "Released/Gen 5", "action": "exclude", "extensions": [".cgb", ".pms", ".pds", ".pwt", ".txt"],
      "rationale": "Fondos de C-Gear, musicales, skins de Pokedex y equipos de torneo: no son plantillas de Pokemon." },
    { "id": "X-G6-LINK", "path": "Released/Gen 6/Pokemon Link", "action": "exclude",
      "rationale": "Datos de Pokemon Link (PL6), no plantillas de Pokemon." },
    { "id": "X-G6-QR", "path": "Released/Gen 6/Secret Base QR Codes", "action": "exclude", "rationale": "Imagenes QR de bases secretas." },
    { "id": "X-G7-QR", "path": "Released/Gen 7/3DS", "action": "exclude", "extensions": [".png"], "rationale": "Imagenes QR (Pokedex de Alola, Magearna, gorra)." },
    { "id": "X-G7-WR", "path": "Released/Gen 7/Switch/Wondercard Records", "action": "exclude", "rationale": "Registros de tarjetas (WR7), no plantillas." },
    { "id": "X-G8-WILD", "path": "Released/Gen 8/SwSh/Wild Area Events", "action": "exclude",
      "rationale": "Bloques BCAT de la Zona Salvaje (Hito 3: los encuentros SwSh ya estan en las tablas del Core)." },
    { "id": "X-G9-RAID", "path": "Released/Gen 9/SV/Raid Events", "action": "exclude",
      "rationale": "Bloques BCAT de incursiones SV (Hito 3: tablas del Core)." },
    { "id": "X-G9-OUTBREAK", "path": "Released/Gen 9/SV/Outbreak Events", "action": "exclude",
      "rationale": "Bloques BCAT de apariciones masivas SV (Hito 3: tablas del Core)." },
    { "id": "X-G9-META", "path": "Released/Gen 9/SV", "action": "exclude", "extensions": [".meta", ".json", ".md", ".txt"], "rationale": "Metadatos." },

    // ---------------- Tarjetas de regalo (parseo oficial con MysteryGift del Core) ----------------
    { "id": "G4-WC4", "path": "Released/Gen 4/Wondercards", "action": "import", "extensions": [".wc4"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados; todas las tarjetas PCD de Gen 4 se convirtieron a formato WC4",
      "approvalNote": "Tarjeta publicada de Gen 4 con parseo oficial correcto",
      "rationale": "Mayoria de tarjetas PCD originales convertidas a WC4. Excepcion documentada en el README: las que solo existian como PGT se reconstruyeron con datos placeholder; se detectan por el nombre del fichero ('(P)' y 'Simulated') y pasan a DocumentedReconstruction.",
      "filenameOverrides": [
        { "pattern": "\\(P\\)", "evidenceClass": "DocumentedReconstruction",
          "rationale": "Marcador '(P)' del repositorio en Gen 4: tarjeta reconstruida desde PGT con datos placeholder (README: 'PGTs were converted to wondercards with placeholder data'). Comprobado: coincide con las tarjetas de CardID=0." }
      ] },
    { "id": "G4-HEX", "path": "Released/Gen 4/hex extracted cards", "action": "import", "extensions": [".pcd", ".pgt"],
      "releaseState": "Published", "evidenceClass": "Unknown", "approve": false, "parse": "MysteryGift",
      "rationale": "Tarjetas 'extraidas por hex': el repositorio no documenta como se extrajeron ni si son volcados fieles. Sin evidencia suficiente -> Unknown (excluida de generar hasta que haya evidencia)." },
    { "id": "G4-RANGER", "path": "Released/Gen 4/Pokemon Ranger Manaphy Egg", "action": "import", "extensions": [".pgt"],
      "releaseState": "Published", "evidenceClass": "Unknown", "approve": false, "parse": "MysteryGift",
      "rationale": "PGT suelto del huevo Manaphy de Ranger: procedencia no documentada en el repositorio -> Unknown." },
    { "id": "G5-PGF", "path": "Released/Gen 5/Wondercards", "action": "import", "extensions": [".pgf"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de Gen 5 (PGF) con parseo oficial correcto",
      "rationale": "Tarjetas PGF de Gen 5 publicadas." },
    { "id": "G5-FULL", "path": "Released/Gen 5/Wondercard Fulls", "action": "import", "extensions": [".wc5full"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta completa (WC5Full) publicada, parseo oficial correcto",
      "rationale": "Tarjetas completas de Gen 5; el lector WC5Full del Core las expone como PGF." },
    { "id": "G6-WC", "path": "Released/Gen 6/Wondercards", "action": "import", "extensions": [".wc6", ".wc6full"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de Gen 6 con parseo oficial correcto",
      "rationale": "Tarjetas WC6/WC6Full publicadas (incluye Pokemon Link con tarjeta)." },
    { "id": "G7-3DS", "path": "Released/Gen 7/3DS/Wondercards", "action": "import", "extensions": [".wc7", ".wc7full"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de Gen 7 (3DS) con parseo oficial correcto",
      "rationale": "Tarjetas WC7/WC7Full publicadas." },
    { "id": "G7-SW", "path": "Released/Gen 7/Switch/Wondercards", "action": "import", "extensions": [".wb7full"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de Let's Go (WB7) con parseo oficial correcto",
      "rationale": "Tarjetas WB7 de Let's Go publicadas." },
    { "id": "G8-SWSH", "path": "Released/Gen 8/SwSh/Wondercards", "action": "import", "extensions": [".wc8"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados; las tarjetas 1053/0146 corregidas viven en 'PKHeX Legality', no aqui",
      "approvalNote": "Tarjeta publicada de Espada/Escudo con parseo oficial correcto",
      "rationale": "Tarjetas WC8 publicadas (BCAT)." },
    { "id": "G8-BDSP", "path": "Released/Gen 8/BDSP/Wondercards", "action": "import", "extensions": [".wb8"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de BDSP con parseo oficial correcto",
      "rationale": "Tarjetas WB8 publicadas." },
    { "id": "G8-PLA", "path": "Released/Gen 8/PLA/Wondercards", "action": "import", "extensions": [".wa8"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de Leyendas Arceus con parseo oficial correcto",
      "rationale": "Tarjetas WA8 publicadas." },
    { "id": "G8-HOME", "path": "Released/Gen 8/HOME Simulated WCs", "action": "import", "extensions": [".wc8", ".wb8", ".wa8"],
      "releaseState": "Published", "evidenceClass": "DocumentedReconstruction", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "Nombre de carpeta 'HOME Simulated WCs' del repositorio EventsGallery: tarjetas simuladas para eventos entregados por HOME",
      "approvalNote": "Reconstruccion documentada (simulada) por el repositorio; solo se aprueba si es identica byte a byte a una tarjeta del Core",
      "rationale": "Tarjetas simuladas, no volcados originales: DocumentedReconstruction. Solo aportan restricciones cuando el Core las corrobora." },
    { "id": "G9-SV", "path": "Released/Gen 9/SV/Wondercards", "action": "import", "extensions": [".wc9"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de Escarlata/Purpura con parseo oficial correcto",
      "rationale": "Tarjetas WC9 publicadas (BCAT)." },
    { "id": "G9-ZA", "path": "Released/Gen 9/ZA/Wondercards", "action": "import", "extensions": [".wa9"],
      "releaseState": "Published", "evidenceClass": "AuthenticDump", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: Released = eventos publicados",
      "approvalNote": "Tarjeta publicada de Leyendas Z-A con parseo oficial correcto",
      "rationale": "Tarjetas WA9 publicadas." },
    { "id": "PKHLEG", "path": "PKHeX Legality", "action": "import", "extensions": [".wc6", ".wc8"],
      "releaseState": "Published", "evidenceClass": "DocumentedReconstruction", "approve": true, "parse": "MysteryGift",
      "evidenceRef": "EventsGallery/README.md: 'These wondercards have been altered and do not match the original preserved data. ... only intended for PKHeX Legality / PKM Generation' (tarjetas 1053 y 0146)",
      "approvalNote": "Tarjeta alterada documentada por el repositorio; solo se aprueba si es identica byte a byte a una tarjeta del Core. Nunca es 'original'",
      "rationale": "Tarjetas corregidas a proposito (forma/genero mal programados en el original): DocumentedReconstruction (regla 9: nunca se presentan como originales)." },

    // ---------------- Tarjetas Gen 3: sin lector publico en el Core ----------------
    { "id": "G3-WC3", "path": "Released/Gen 3", "action": "import", "extensions": [".wc3", ".me3"],
      "releaseState": "Published", "evidenceClass": "Unknown", "approve": false, "parse": "None",
      "rationale": "Tarjetas de e-Reader/Mystery Event de Gen 3: el Core no expone un lector publico (los eventos de Gen 1-3 viven en sus tablas, EncountersWC3); sin parseo oficial -> Unknown, excluidas de generar." },

    // ---------------- Pokemon individuales (volcados): material de investigacion, no plantillas ----------------
    { "id": "E-G1", "path": "Released/Gen 1", "action": "import", "extensions": [".pk1"],
      "releaseState": "Published", "evidenceClass": "ResearchOnly", "approve": false, "parse": "Entity",
      "rationale": "Ficheros PK1 sueltos de distribuciones: ejemplares concretos (PID/DV de un caso), no plantillas de evento. Material de regresion/investigacion (ResearchOnly)." },
    { "id": "E-G2", "path": "Released/Gen 2", "action": "import", "extensions": [".pk2"],
      "releaseState": "Published", "evidenceClass": "ResearchOnly", "approve": false, "parse": "Entity",
      "rationale": "Idem para PK2." },
    { "id": "E-G3", "path": "Released/Gen 3", "action": "import", "extensions": [".pk3"],
      "releaseState": "Published", "evidenceClass": "ResearchOnly", "approve": false, "parse": "Entity",
      "rationale": "PK3 sueltos (Pokemon Center NY, Berry Glitch, Pokemon Box...): ejemplares concretos, util para estudiar el RNG de distribucion; no son plantillas. ResearchOnly." },
    { "id": "E-G4", "path": "Released/Gen 4", "action": "import", "extensions": [".pk4"],
      "releaseState": "Published", "evidenceClass": "ResearchOnly", "approve": false, "parse": "Entity",
      "rationale": "PK4 sueltos (Ranch, Palpark, intercambio de distribucion): ejemplares concretos; el README dice que no publican Pokemon individuales de Gen 4+ salvo excepciones. ResearchOnly." },
    { "id": "E-G5", "path": "Released/Gen 5/Dream World", "action": "import", "extensions": [".pk5"],
      "releaseState": "Published", "evidenceClass": "ResearchOnly", "approve": false, "parse": "Entity",
      "rationale": "PK5 de Dream World: ejemplares concretos; las reglas de Dream World ya estan en las tablas del Core. ResearchOnly." }
  ]
