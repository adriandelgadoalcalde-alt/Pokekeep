<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AutoLegalidad.Desafios</RootNamespace>
    <IsPackable>false</IsPackable>
    <NeutralLanguage>es-ES</NeutralLanguage>
    <!-- R-013: biblioteca comun de desafios (rachas, jefes y maximos de cada juego, Pokeathlon). SOLO depende de PKHeX.Core y no tiene interfaz: la usan el escritorio (AutoLegalidad.Ui, parche 0104) y Android (Pokekeep.Mobile.Ui). -->
  </PropertyGroup>
  <!-- En la compilacion del APK (PokekeepAndroid) el codigo de src\ pasa a net10.0-android, pero a esta biblioteca la referencia Pokekeep.Mobile.Ui, que es net10.0 (la comparten las
       pruebas headless): se queda en net10.0 como el Core, que tampoco tiene nada de Android. Sin esto el APK no restaura (NU1201, 14-nov-2026). -->
  <PropertyGroup Condition="'$(PokekeepAndroid)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PKHeXCoreProject)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Nombres de instalaciones, modos, jefes y motivos, en es-ES y en (clave, es, en). -->
    <EmbeddedResource Include="Recursos\textos-desafios.tsv" LogicalName="textos-desafios.tsv" />
    <InternalsVisibleTo Include="AutoLegalidad.DesafiosTests" />
  </ItemGroup>
</Project>
