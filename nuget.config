<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Una sola fuente; la caché global se redirige con NUGET_PACKAGES (ver herramientas/entorno.ps1). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
